    {
      "id": "inspect",
      "intent": "Explicit show subcommand avoids TUI; parses local material; no upstream discovery.",
      "argv": [
        "./bin/certconv",
        "show",
        "{certificate}",
        "--json"
      ],
      "effects": [
        "read",
        "process"
      ],
      "acceptance_scope": "runtime",
      "inputs": [
        "internal/cli/build_show_command.go",
        "internal/cert/info.go"
      ],
      "requires": [
        {
          "kind": "operator",
          "reason": "built bin/certconv"
        },
        {
          "kind": "operator",
          "reason": "readable local PEM/DER/PFX; password input for encrypted PFX"
        }
      ],
      "recovery": "Correct unreadable/invalid input; supply protected password-file/stdin and rerun.",
      "parameters": {
        "certificate": {
          "pattern": "[^\\x00\\r\\n]+",
          "description": "Explicit operator-selected input; supplied as one argv value."
        }
      }
    },
    {
      "id": "convert-der",
      "intent": "Creates new output, O_EXCL/no-overwrite path; local certificate conversion.",
      "argv": [
        "./bin/certconv",
        "to-der",
        "{certificate}",
        "{new_output}"
      ],
      "effects": [
        "read",
        "local_write",
        "process"
      ],
      "acceptance_scope": "runtime",
      "inputs": [
        "internal/cli/build_convert_command.go",
        "internal/cert/output.go"
      ],
      "requires": [
        {
          "kind": "operator",
          "reason": "built CLI"
        },
        {
          "kind": "operator",
          "reason": "readable certificate"
        },
        {
          "kind": "operator",
          "reason": "writable destination directory; output absent"
        }
      ],
      "recovery": "Use suggested incremented output path after conflict; do not remove another writer's output.",
      "parameters": {
        "certificate": {
          "pattern": "[^\\x00\\r\\n]+",
          "description": "Explicit operator-selected input; supplied as one argv value."
        },
        "new_output": {
          "pattern": "[^\\x00\\r\\n]+",
          "description": "Explicit operator-selected input; supplied as one argv value."
        }
      }
    },
    {
      "id": "extract-pfx",
      "intent": "Extract certificate/key/optional CA; key staged mode 0600 before final publication; secret file input avoids argv secret. Multi-output rollback removes only matching owned inode links.",
      "argv": [
        "./bin/certconv",
        "from-pfx",
        "{bundle}",
        "{new_directory}",
        "--password-file",
        "{password_file}",
        "--json"
      ],
      "effects": [
        "read",
        "local_write",
        "process"
      ],
      "acceptance_scope": "runtime",
      "inputs": [
        "internal/cli/build_convert_command.go",
        "internal/cert/output.go",
        "internal/cert/pfx_transaction_test.go"
      ],
      "requires": [
        {
          "kind": "operator",
          "reason": "OpenSSL available"
        },
        {
          "kind": "operator",
          "reason": "bundle/password readable"
        },
        {
          "kind": "operator",
          "reason": "destination same filesystem staging supports links"
        }
      ],
      "recovery": "Fix password or conflicting output; owned partial links are rolled back; retry preserves pre-existing outputs.",
      "parameters": {
        "bundle": {
          "pattern": "[^\\x00\\r\\n]+",
          "description": "Explicit operator-selected input; supplied as one argv value."
        },
        "new_directory": {
          "pattern": "[^\\x00\\r\\n]+",
          "description": "Explicit operator-selected input; supplied as one argv value."
        },
        "password_file": {
          "pattern": "[^\\x00\\r\\n]+",
          "description": "Explicit operator-selected input; supplied as one argv value."
        }
      }
    },
    {
      "id": "verify-domain",
      "intent": "Checks foreign dangling symlink preservation, owned link rollback, retry viability and private key 0600; no real user certificates.",
      "argv": [
        "make",
        "test-domain"
      ],
      "effects": [
        "read",
        "local_write",
        "process"
      ],
      "acceptance_scope": "fixture",
      "inputs": [
        "Makefile",
        "internal/cert/output_test.go",
        "internal/cert/pfx_transaction_test.go",
        "go.mod",
        "go.sum",
        "test/hooks/local_ci.bats"
      ],
      "requires": [],
      "recovery": "Inspect failed subcase extraction/key publication/CA publication and rerun after owner repair."
    }
  ],
  "learning": [
    {
      "id": "owner-invariant-1",
      "summary": "Exclusive publication must retain staging identity through the whole PFX output set: rollback removes only links belonging to this operation and leaves conflicting output/symlink intact.",
      "when": [
        "When changing output conversion, cleanup, retry behavior or private-key permissions."
      ],
